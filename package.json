{
  "name": "chassis",
  "version": "0.1.0",
  "private": true,
  "description": "Chassis — the Native Factory's reusable SKU framework. A closed-loop Next.js + Stripe + Prisma spine (auth, billing, entitlement, email, scheduler, founder-gated charges) that any SKU inherits; the SKU supplies a DomainPack (rules, artifacts, cadence, brand). Reference pack: domains/fmcsa (DOT Navigator).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "node --import tsx --test lib/*.test.ts domain/*.test.ts",
    "smoke:loop": "node --import tsx scripts/smoke-closed-loop.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "14.2.35",
    "prisma": "^6.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
