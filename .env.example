# DOT Navigator — copy to .env.local (gitignored, auto-loaded by Next). NEVER commit real keys.
#
# TEST MODE ONLY for preview. The free calendar works with NO keys; only the one-time audit-packet
# unlock (checkout) needs Stripe. Real charging is founder-gated — see GO-LIVE.md.

# --- Stripe (TEST keys for preview) ---
# Get test keys at https://dashboard.stripe.com/test/apikeys . Use sk_test_ / pk_test_.
STRIPE_SECRET_KEY=            # sk_test_...   (server only)
STRIPE_PUBLISHABLE_KEY=       # pk_test_...   (public by design; not yet used client-side)
# Optional: a pre-made one-time Price id. If unset, the app builds an inline price from the amount below.
STRIPE_PRICE_ID=
# Webhook signing secret from `stripe listen` or the dashboard endpoint (for /api/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=        # whsec_...

# --- Entitlement signing (the no-DB proof of purchase) ---
# A long random string. Signs the HMAC entitlement token. Generate: `openssl rand -hex 32`.
ENTITLEMENT_SIGNING_SECRET=

# --- Price (legacy one-time unlock) ---
# Founding one-time price in whole USD. NEXT_PUBLIC_ so server (charge) and client (display) agree.
NEXT_PUBLIC_UNLOCK_PRICE_USD=49

# --- Subscription (the primary model: done-for-you co-pilot) ---
# Monthly price the client displays + the server charges if no Price ID is set. Free = account + tracking;
# paid = prepared documents + proactive reminders.
NEXT_PUBLIC_SUBSCRIPTION_PRICE_USD=49.99
# Optional: a pre-made recurring Price id (overrides the inline price above).
STRIPE_SUBSCRIPTION_PRICE_ID=
# Free-trial length in days (full access, no card charge until it converts).
SUBSCRIPTION_TRIAL_DAYS=14
# Webhook events to enable on the Stripe endpoint: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted.

# --- The live-charge gate (SKU-level echo of the factory's D5) ---
# Leave UNSET for preview. The checkout route REFUSES a live sk_live_ key unless this is exactly "true".
# Flipping this to live is a deliberate, founder-only act — see GO-LIVE.md.
LIVE_CHARGES_ENABLED=

# --- Closed-loop foundation (D19): accounts + persistence + reminders ---
# Postgres for the carrier's remembered state (Railway: add a Postgres plugin, copy its URL).
# After setting this, run: npm run db:migrate   (creates the tables from prisma/schema.prisma)
DATABASE_URL=                 # postgresql://user:pass@host:5432/dbname

# Brevo powers passwordless magic-link sign-in AND proactive deadline reminders (transactional email).
# Get a v3 API key at https://app.brevo.com (Settings → SMTP & API → API Keys). The app degrades to a
# logged no-op if unset.
BREVO_API_KEY=                # xkeysib-...
# The verified sender. EMAIL_FROM accepts "Name <email>"; the address must be a verified sender/domain in
# Brevo. Or set BREVO_SENDER_EMAIL / BREVO_SENDER_NAME instead.
EMAIL_FROM=                   # "DOT Navigator <hello@yourdomain.com>"
BREVO_SENDER_EMAIL=           # fallback if EMAIL_FROM is unset
BREVO_SENDER_NAME=            # fallback display name

# Absolute origin used to build magic-link URLs (and reminder links). Optional in dev (derived from the
# request); set it in production so links point at the real domain.
APP_ORIGIN=                   # https://your-deployed-url

# Shared secret the reminder cron presents to POST /api/cron/reminders (so only your scheduler can fire it).
CRON_SECRET=                  # openssl rand -hex 24
